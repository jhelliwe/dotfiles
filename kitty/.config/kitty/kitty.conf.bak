background_blur 1


# BEGIN_KITTY_THEME
# ANSI 1987
include current-theme.conf
# END_KITTY_THEME

background_opacity 0.9
background_tint 20

# BEGIN_KITTY_FONTS
font_family      family="Cousine"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
#
enable_audio_bell no
